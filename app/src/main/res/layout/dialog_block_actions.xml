<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Details are capped to a few lines (with ellipsis) so a long notification
         can never push the action buttons off-screen. Full text is in the log row. -->
    <TextView
        android:id="@+id/dlgDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:maxLines="8"
        android:ellipsize="end"
        android:paddingBottom="12dp"
        android:textIsSelectable="true" />

    <Button
        android:id="@+id/dlgBlockChannel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/dlgBlockApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/dlgBlockKeyword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/dlgIgnoreApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
